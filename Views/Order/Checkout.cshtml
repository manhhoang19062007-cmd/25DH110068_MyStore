@model _25DH110068_MyStore.Models.Customer
@{
    ViewBag.Title = "Xác nhận đặt hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var cart = ViewBag.Cart as List<_25DH110068_MyStore.Models.CartItem>;
}

<div class="container" style="margin-top: 25px;">
    <h2>Xác nhận thông tin đặt hàng</h2>
    <hr />

    <div class="row">
        <!-- Cột trái: Tóm tắt giỏ hàng -->
        <div class="col-md-7">
            <h4>Danh sách món đã chọn</h4>
            <table class="table table-bordered">
                <thead>
                    <tr class="active">
                        <th>Món ăn</th>
                        <th>Đơn giá</th>
                        <th style="width: 80px;">SL</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cart != null)
                    {
                        foreach (var item in cart)
                        {
                            <tr>
                                <td>@item.Product.ProductName</td>
                                <td>@(Convert.ToDecimal(item.Product.ProductPrice).ToString("N0")) đ</td>
                                <td>@item.Quantity</td>
                                <td style="color: #d9534f; font-weight: bold;">@item.TotalPrice.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-right" style="font-weight: bold;">Tổng tiền:</td>
                        <td style="color: #d9534f; font-weight: bold; font-size: 18px;">
                            @(((decimal)ViewBag.TotalAmount).ToString("N0")) đ
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Cột phải: Thông tin giao hàng -->
        <div class="col-md-5">
            <div class="panel panel-primary">
                <div class="panel-heading"><h3 class="panel-title">Thông tin người nhận</h3></div>
                <div class="panel-body">
                    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label>Họ và tên người nhận:</label>
                            <input type="text" class="form-control" value="@Model.CustomerName" readonly />
                        </div>

                        <div class="form-group">
                            <label>Số điện thoại liên hệ:</label>
                            <input type="text" class="form-control" value="@Model.CustomerPhone" readonly />
                        </div>

                        <div class="form-group">
                            <label>Địa chỉ nhận hàng:</label>
                            <textarea name="shippingAddress" class="form-control" rows="3" required>@Model.CustomerAddress</textarea>
                        </div>

                        <button type="submit" class="btn btn-success btn-block btn-lg" onclick="return confirm('Xác nhận đặt đơn hàng này?');">
                            Xác nhận đặt hàng
                        </button>
                        <hr />
                        <!-- Nút chuyển sang thanh toán bằng PayPal -->
                        <form action="@Url.Action("PaymentWithPaypal", "Order")" method="post">
                            <button type="submit" class="btn btn-warning btn-block btn-lg" style="margin-top: 10px;">
                                <i class="glyphicon glyphicon-credit-card"></i> Thanh toán bằng PayPal
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>