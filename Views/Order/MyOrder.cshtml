@model IEnumerable<_25DH110068_MyStore.Models.Order>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="margin-top: 25px;">
    <h2>Lịch sử đơn hàng</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
    }
    else
    {
<table class="table table-bordered table-striped">
    <thead>
        <tr class="info">
            <th>Mã đơn</th>
            <th>Ngày đặt</th>
            <th>Địa chỉ nhận</th>
            <th>Tổng tiền</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td style="font-weight: bold;">#@order.OrderID</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@order.AddressDelivery</td>
                <td style="color: #d9534f; font-weight: bold;">
                    @(Convert.ToDecimal(order.TotalAmount).ToString("N0")) đ
                </td>
                <td style="text-align: center;">
                    <a href="@Url.Action("OrderDetails", "Order", new { id = order.OrderID })" class="btn btn-sm btn-info">
                        Chi tiết
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
    }
</div>