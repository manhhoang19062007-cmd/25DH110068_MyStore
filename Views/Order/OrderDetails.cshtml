@model IEnumerable<_25DH110068_MyStore.Models.OrderDetail>
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var order = ViewBag.Order as _25DH110068_MyStore.Models.Order;
}

<div class="container" style="margin-top: 25px;">
    <h2>Chi tiết đơn hàng #@order.OrderID</h2>
    <hr />

    <div class="panel panel-default">
        <div class="panel-body">
            <p><strong>Ngày đặt hàng:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Địa chỉ giao nhận:</strong> @order.AddressDelivery</p>
            <p><strong>Người nhận:</strong> @order.Customer.CustomerName (@order.Customer.CustomerPhone)</p>
        </div>
    </div>

    <h4>Danh sách sản phẩm</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr class="info">
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th style="width: 100px;">Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: bold;">@item.Product.ProductName</td>
                    <td>@(Convert.ToDecimal(item.UnitPrice).ToString("N0")) đ</td>
                    <td>@item.Quantity</td>
                    <td style="color: #d9534f; font-weight: bold;">
                        @((Convert.ToDecimal(item.UnitPrice) * item.Quantity).ToString("N0")) đ
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right" style="font-weight: bold; font-size: 16px;">Tổng đơn hàng:</td>
                <td style="color: #d9534f; font-weight: bold; font-size: 18px;">
                    @(Convert.ToDecimal(order.TotalAmount).ToString("N0")) đ
                </td>
            </tr>
        </tfoot>
    </table>

    <p style="margin-top: 20px;">
        <a href="@Url.Action("MyOrder", "Order")" class="btn btn-default">
            <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách đơn hàng
        </a>
    </p>
</div>