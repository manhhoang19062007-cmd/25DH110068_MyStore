@model IEnumerable<_25DH110068_MyStore.Models.Product>
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="row" style="margin-top: 20px;">
    <!-- Cột bên trái: Danh mục sản phẩm -->
    <div class="col-md-3">
        <div class="list-group">
            <a href="@Url.Action("Index", "Home")" class="list-group-item active">
                Tất cả danh mục
            </a>
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in (List<_25DH110068_MyStore.Models.Category>)ViewBag.Categories)
                {
                    <a href="@Url.Action("Index", "Home", new { categoryId = cat.CategoryID })" class="list-group-item">
                        @cat.CategoryName
                    </a>
                }
            }
        </div>
    </div>

    <!-- Cột bên phải: Lưới danh sách sản phẩm -->
    <div class="col-md-9">
        <h3 style="margin-top: 0; margin-bottom: 20px;">Danh sách món ăn</h3>

        @if (!Model.Any())
        {
            <div class="alert alert-warning">
                Chưa có sản phẩm nào thuộc danh mục này hoặc từ khóa tìm kiếm không khớp.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-sm-6 col-md-4" style="margin-bottom: 25px;">
                        <div class="thumbnail text-center" style="border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                            <!-- Ảnh sản phẩm -->
                            <img src="@Url.Content("~/Images/" + item.ProductImage)" alt="@item.ProductName"
                                 style="width: 100%; height: 180px; object-fit: cover; border-top-left-radius: 8px; border-top-right-radius: 8px;" />

                            <div class="caption">
                                <h4 style="font-weight: bold; margin-top: 10px; height: 38px; overflow: hidden;">
                                    @item.ProductName
                                </h4>
                                <p style="color: #666; font-size: 13px; height: 36px; overflow: hidden;">
                                    @item.ProductDecription
                                </p>
                                <p style="color: #d9534f; font-weight: bold; font-size: 17px;">
                                    @(Convert.ToDecimal(item.ProductPrice).ToString("N0")) đ
                                </p>
                                <p>
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-default" role="button">
                                        Chi tiết
                                    </a>
                                    <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-primary" role="button">
                                        <i class="glyphicon glyphicon-shopping-cart"></i> Thêm vào giỏ
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>