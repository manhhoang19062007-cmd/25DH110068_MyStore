@model _25DH110068_MyStore.Models.Product
@{
    ViewBag.Title = Model.ProductName;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var relatedProducts = ViewBag.RelatedProducts as List<_25DH110068_MyStore.Models.Product>;
}

<div class="container" style="margin-top: 30px;">
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li><a href="@Url.Action("Index", "Home", new { categoryId = Model.CategoryID })">@Model.Category.CategoryName</a></li>
        <li class="active">@Model.ProductName</li>
    </ol>

    <div class="row">
        <!-- Ảnh sản phẩm lớn -->
        <div class="col-md-5 text-center">
            <img src="@Url.Content("~/Images/" + Model.ProductImage)" alt="@Model.ProductName"
                 class="img-responsive img-thumbnail" style="max-height: 380px; width: 100%; object-fit: cover;" />
        </div>

        <!-- Thông tin chi tiết & Đặt mua -->
        <div class="col-md-7">
            <h2>@Model.ProductName</h2>
            <p class="text-muted">Danh mục: <strong>@Model.Category.CategoryName</strong></p>
            <h3 style="color: #d9534f; font-weight: bold; margin: 20px 0;">
                @(Convert.ToDecimal(Model.ProductPrice).ToString("N0")) đ
            </h3>

            <div class="well">
                <h4>Mô tả món ăn:</h4>
                <p>@Model.ProductDecription</p>
            </div>

            @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Get, new { @class = "form-inline", style = "margin-top: 25px;" }))
            {
                <input type="hidden" name="id" value="@Model.ProductID" />
                <div class="form-group">
                    <label for="quantity" style="margin-right: 10px;">Số lượng:</label>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" class="form-control" style="width: 80px;" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg" style="margin-left: 10px;">
                    <i class="glyphicon glyphicon-shopping-cart"></i> Thêm vào giỏ hàng
                </button>
            }
        </div>
    </div>

    <!-- Món ăn cùng danh mục liên quan -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <hr style="margin-top: 50px;" />
        <h3>Món ăn tương tự</h3>
        <div class="row" style="margin-top: 20px;">
            @foreach (var item in relatedProducts)
            {
                <div class="col-sm-6 col-md-3">
                    <div class="thumbnail text-center">
                        <img src="@Url.Content("~/Images/" + item.ProductImage)" style="height: 140px; width: 100%; object-fit: cover;" />
                        <div class="caption">
                            <h5 style="font-weight: bold; height: 35px; overflow: hidden;">@item.ProductName</h5>
                            <p style="color: #d9534f; font-weight: bold;">@(Convert.ToDecimal(item.ProductPrice).ToString("N0")) đ</p>
                            <p>
                                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-default btn-sm">Xem chi tiết</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>