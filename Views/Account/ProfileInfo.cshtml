@model _25DH110068_MyStore.Models.Customer
@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="row" style="margin-top: 30px;">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-primary">
            <div class="panel-heading"><h3 class="panel-title">Thông tin tài khoản khách hàng</h3></div>
            <div class="panel-body">
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">@ViewBag.Message</div>
                }

                @using (Html.BeginForm("ProfileInfo", "Account", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.CustomerID)
                    @Html.HiddenFor(m => m.Username)

                    <div class="form-group">
                        <label class="col-md-3 control-label">Tên tài khoản:</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" value="@Model.Username" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.CustomerName, "Họ và tên", new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", required = "required" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.CustomerPhone, "Số điện thoại", new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", required = "required" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.CustomerEmail, "Email", new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.CustomerAddress, "Địa chỉ nhận hàng", new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.TextAreaFor(m => m.CustomerAddress, new { @class = "form-control", rows = "3", required = "required" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-3 col-md-9">
                            <button type="submit" class="btn btn-success">Lưu thông tin</button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-default">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>